+import { describe, expect, it } from "vitest";
+import {
+  clampWidth,
+  defaultLayout,
+  isCollapsed,
+  maxWidthFor,
+  normalize,
+  nudge,
+  parseLayout,
+  readLayout,
+  resizeTo,
+  SIDEBAR_COLLAPSE_AT,
+  SIDEBAR_DEFAULT_WIDTH,
+  SIDEBAR_LAYOUT_STORAGE_KEY,
+  SIDEBAR_MAX_WIDTH,
+  SIDEBAR_MIN_WIDTH,
+  toggleCollapsed,
+  widthFromDrag,
+  writeLayout,
+  type SidebarLayout,
+} from "./sidebar-width.js";
+
+const WIDE = 1920;
+
+class MemoryStorage {
+  private readonly values = new Map<string, string>();
+
+  getItem(key: string): string | null {
+    return this.values.get(key) ?? null;
+  }
+
+  setItem(key: string, value: string): void {
+    this.values.set(key, value);
+  }
+}
+
+class HostileStorage {
+  getItem(): string | null {
+    throw new Error("access denied");
+  }
+
+  setItem(): void {
+    throw new Error("quota exceeded");
+  }
+}
+
+describe("maxWidthFor", () => {
+  it("never exceeds the absolute ceiling on a wide screen", () => {
+    expect(maxWidthFor(5120)).toBe(SIDEBAR_MAX_WIDTH);
+  });
+
+  it("gives up at most half of a narrow window", () => {
+    expect(maxWidthFor(1280)).toBe(640);
+  });
+
+  it("keeps the band valid when half the window is below the minimum", () => {
+    expect(maxWidthFor(400)).toBe(SIDEBAR_MIN_WIDTH);
+  });
+});
+
+describe("clampWidth", () => {
+  it("keeps a width inside the band", () => {
+    expect(clampWidth(480, WIDE)).toBe(480);
+  });
+
+  it("raises a width between the threshold and the minimum", () => {
+    expect(clampWidth(SIDEBAR_COLLAPSE_AT + 1, WIDE)).toBe(SIDEBAR_MIN_WIDTH);
+  });
+
+  it("collapses at or below the threshold", () => {
+    expect(clampWidth(SIDEBAR_COLLAPSE_AT, WIDE)).toBe(0);
+    expect(clampWidth(-200, WIDE)).toBe(0);
+  });
+
+  it("caps against the viewport, not only the ceiling", () => {
+    expect(clampWidth(700, 1200)).toBe(600);
+  });
+
+  it("rounds fractional drag positions", () => {
+    expect(clampWidth(327.6, WIDE)).toBe(328);
+  });
+
+  it("falls back to collapsed-free defaults on a non-number", () => {
+    expect(clampWidth(Number.NaN, WIDE)).toBe(0);
+  });
+});
+
+describe("normalize", () => {
+  it("defaults a missing preference to the upstream width", () => {
+    expect(normalize(undefined, WIDE)).toEqual({
+      width: SIDEBAR_DEFAULT_WIDTH,
+      expandedWidth: SIDEBAR_DEFAULT_WIDTH,
+    });
+  });
+
+  it("shrinks a stored width that no longer fits the window", () => {
+    expect(normalize({ width: 700, expandedWidth: 700 }, 1200)).toEqual({
+      width: 600,
+      expandedWidth: 600,
+    });
+  });
+
+  it("keeps the restore width while collapsed", () => {
+    expect(normalize({ width: 0, expandedWidth: 520 }, WIDE)).toEqual({
+      width: 0,
+      expandedWidth: 520,
+    });
+  });
+
+  it("never stores 0 as the restore width", () => {
+    expect(normalize({ width: 0, expandedWidth: 0 }, WIDE).expandedWidth).toBe(
+      SIDEBAR_DEFAULT_WIDTH,
+    );
+  });
+});
+
+describe("resizeTo", () => {
+  it("moves both width and restore width together", () => {
+    expect(resizeTo(defaultLayout(WIDE), 500, WIDE)).toEqual({ width: 500, expandedWidth: 500 });
+  });
+
+  it("collapsing by drag preserves what to restore", () => {
+    const layout: SidebarLayout = { width: 500, expandedWidth: 500 };
+    expect(resizeTo(layout, 20, WIDE)).toEqual({ width: 0, expandedWidth: 500 });
+  });
+});
+
+describe("toggleCollapsed", () => {
+  it("round-trips without losing the chosen width", () => {
+    const chosen: SidebarLayout = { width: 460, expandedWidth: 460 };
+    const collapsed = toggleCollapsed(chosen, WIDE);
+    expect(isCollapsed(collapsed)).toBe(true);
+    expect(toggleCollapsed(collapsed, WIDE)).toEqual(chosen);
+  });
+
+  it("expands into the current window when the remembered width no longer fits", () => {
+    const collapsed: SidebarLayout = { width: 0, expandedWidth: 700 };
+    expect(toggleCollapsed(collapsed, 1200)).toEqual({ width: 600, expandedWidth: 600 });
+  });
+});
+
+describe("nudge", () => {
+  it("steps in both directions", () => {
+    expect(nudge({ width: 400, expandedWidth: 400 }, 16, WIDE).width).toBe(416);
+    expect(nudge({ width: 400, expandedWidth: 400 }, -16, WIDE).width).toBe(384);
+  });
+
+  it("expanding from collapsed lands on the remembered width, not on one step", () => {
+    expect(nudge({ width: 0, expandedWidth: 480 }, 16, WIDE)).toEqual({
+      width: 480,
+      expandedWidth: 480,
+    });
+  });
+
+  it("shrinking while collapsed is a no-op", () => {
+    const collapsed: SidebarLayout = { width: 0, expandedWidth: 480 };
+    expect(nudge(collapsed, -16, WIDE)).toBe(collapsed);
+  });
+
+  it("jams at the minimum instead of collapsing, so a held key cannot hide the list", () => {
+    expect(nudge({ width: SIDEBAR_MIN_WIDTH, expandedWidth: SIDEBAR_MIN_WIDTH }, -16, WIDE)).toEqual(
+      { width: SIDEBAR_MIN_WIDTH, expandedWidth: SIDEBAR_MIN_WIDTH },
+    );
+  });
+});
+
+describe("widthFromDrag", () => {
+  it("follows the pointer one-to-one to the right", () => {
+    expect(widthFromDrag({ x: 320, width: 320 }, 500)).toBe(500);
+  });
+
+  it("follows the pointer to the left", () => {
+    expect(widthFromDrag({ x: 320, width: 320 }, 260)).toBe(260);
+  });
+
+  it("a drag that starts collapsed measures from zero, so it needs a real pull", () => {
+    const asked = widthFromDrag({ x: 60, width: 0 }, 160);
+    expect(asked).toBe(100);
+    expect(clampWidth(asked, WIDE)).toBe(0);
+    expect(clampWidth(widthFromDrag({ x: 60, width: 0 }, 400), WIDE)).toBe(340);
+  });
+});
+
+describe("parseLayout", () => {
+  it("survives garbage, empty and wrong-shaped values", () => {
+    for (const raw of [null, "", "not json", "[]", "7", '{"width":"wide"}']) {
+      expect(parseLayout(raw, WIDE)).toEqual(defaultLayout(WIDE));
+    }
+  });
+
+  it("reads a stored preference back", () => {
+    expect(parseLayout('{"width":520,"expandedWidth":520}', WIDE)).toEqual({
+      width: 520,
+      expandedWidth: 520,
+    });
+  });
+});
+
+describe("storage round trip", () => {
+  it("writes under the documented key and reads the same layout back", () => {
+    const storage = new MemoryStorage();
+    writeLayout(storage, { width: 0, expandedWidth: 520 });
