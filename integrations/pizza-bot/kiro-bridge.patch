+describe("GET /kiro/handoffs/pending", () => {
+  async function pendingDir(root: string) {
+    const dir = join(root, "data", "bridge", "pending");
+    await import("node:fs/promises").then(({ mkdir }) => mkdir(dir, { recursive: true }));
+    return dir;
+  }
+
+  it("is empty, not an error, before any handoff exists", async () => {
+    const f = await fixture();
+    const response = await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/handoffs/pending");
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ pending: [] });
+  });
+
+  it("lists outstanding handoffs oldest first", async () => {
+    const f = await fixture();
+    const dir = await pendingDir(f.root);
+    await writeFile(
+      join(dir, "h-new.json"),
+      JSON.stringify({ handoffId: "h-new", threadId: "t2", target: "second-agent", requestedAt: "2026-09-21T10:00:00.000Z" }),
+    );
+    await writeFile(
+      join(dir, "h-old.json"),
+      JSON.stringify({ handoffId: "h-old", threadId: "t1", target: "demo-agent", requestedAt: "2026-09-21T09:00:00.000Z" }),
+    );
+
+    const response = await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/handoffs/pending");
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      pending: [
+        { handoffId: "h-old", threadId: "t1", target: "demo-agent", requestedAt: "2026-09-21T09:00:00.000Z" },
+        { handoffId: "h-new", threadId: "t2", target: "second-agent", requestedAt: "2026-09-21T10:00:00.000Z" },
+      ],
+    });
+  });
+
+  it("skips entries that cannot name a thread and a target", async () => {
+    const f = await fixture();
+    const dir = await pendingDir(f.root);
+    await writeFile(join(dir, "broken.json"), "{");
+    await writeFile(join(dir, "no-target.json"), JSON.stringify({ handoffId: "h1", threadId: "t1" }));
+    await writeFile(join(dir, "no-thread.json"), JSON.stringify({ handoffId: "h2", target: "second-agent" }));
+    await writeFile(join(dir, "not-json.txt"), JSON.stringify({ handoffId: "h3", threadId: "t3", target: "x" }));
+    await writeFile(
+      join(dir, "good.json"),
+      JSON.stringify({ handoffId: "h-good", threadId: "t-good", target: "demo-agent", requestedAt: "2026-09-21T09:00:00.000Z" }),
+    );
+
+    const response = await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/handoffs/pending");
+    const body = (await response.json()) as { pending: Array<{ handoffId: string }> };
+    expect(body.pending.map((item) => item.handoffId)).toEqual(["h-good"]);
+  });
+
+  it("surfaces a handoff the moment the send route accepts it", async () => {
