index 0000000..234ce96
--- /dev/null
+++ b/apps/web/src/lib/sidebar-width.ts
@@ -0,0 +1,139 @@
+/** Width of the inbox conversation list, as a user preference.
+ *
+ *  Upstream pins the pane at 320px, which truncates most agent subjects. The
+ *  preference is one number because the list is one pane: `width` 0 means
+ *  collapsed, and `expandedWidth` remembers what to come back to, so expanding
+ *  after a reload does not silently reset to the default.
+ *
+ *  Every value is clamped against the CURRENT viewport rather than stored
+ *  pre-clamped: the same profile opens on a 2560px monitor and on a 1280px
+ *  laptop, and a width that is comfortable on one would swallow the other.
+ */
+
+export const SIDEBAR_LAYOUT_STORAGE_KEY = "pizza-sidebar-layout";
+export const SIDEBAR_DEFAULT_WIDTH = 320;
+export const SIDEBAR_MIN_WIDTH = 240;
+export const SIDEBAR_MAX_WIDTH = 720;
+/** A drag released below this collapses the pane, as a pane handle usually does. */
+export const SIDEBAR_COLLAPSE_AT = 160;
+/** Arrow-key step on the handle. Shift multiplies it in the component. */
+export const SIDEBAR_KEYBOARD_STEP = 16;
+
+export interface SidebarLayout {
+  /** Rendered width in px. 0 means collapsed. */
+  width: number;
+  /** Width to restore on expand. Never 0. */
+  expandedWidth: number;
+}
+
+export type SidebarStorage = Pick<Storage, "getItem" | "setItem">;
+
+export function isCollapsed(layout: SidebarLayout): boolean {
+  return layout.width === 0;
+}
+
+/** Widest the pane may get on this viewport. Half the window keeps the reading
+ *  pane usable, and MIN wins on a narrow window so the band never inverts. */
+export function maxWidthFor(viewportWidth: number): number {
+  const half = Math.floor((Number.isFinite(viewportWidth) ? viewportWidth : 0) / 2);
+  return Math.max(SIDEBAR_MIN_WIDTH, Math.min(SIDEBAR_MAX_WIDTH, half));
+}
+
+/** Snaps to collapsed below the threshold, otherwise into [MIN, max(viewport)]. */
+export function clampWidth(width: number, viewportWidth: number): number {
+  if (!Number.isFinite(width) || width <= SIDEBAR_COLLAPSE_AT) return 0;
+  return Math.min(Math.max(Math.round(width), SIDEBAR_MIN_WIDTH), maxWidthFor(viewportWidth));
+}
+
+function clampExpanded(value: unknown, viewportWidth: number): number {
+  const max = maxWidthFor(viewportWidth);
+  if (typeof value !== "number" || !Number.isFinite(value) || value <= SIDEBAR_COLLAPSE_AT) {
+    return Math.min(SIDEBAR_DEFAULT_WIDTH, max);
+  }
+  return Math.min(Math.max(Math.round(value), SIDEBAR_MIN_WIDTH), max);
+}
+
+export function defaultLayout(viewportWidth: number): SidebarLayout {
+  const width = clampExpanded(SIDEBAR_DEFAULT_WIDTH, viewportWidth);
+  return { width, expandedWidth: width };
+}
+
+/** Brings any shape - a stored object, a stale state, a narrower window - back
+ *  into the band without losing the collapsed/expanded distinction. */
+export function normalize(
+  layout: Partial<SidebarLayout> | null | undefined,
+  viewportWidth: number,
+): SidebarLayout {
+  const expandedWidth = clampExpanded(layout?.expandedWidth, viewportWidth);
+  const raw = layout?.width;
+  if (typeof raw !== "number" || !Number.isFinite(raw)) {
+    return { width: expandedWidth, expandedWidth };
+  }
+  const width = clampWidth(raw, viewportWidth);
+  return { width, expandedWidth: width === 0 ? expandedWidth : width };
+}
+
+export function resizeTo(layout: SidebarLayout, width: number, viewportWidth: number): SidebarLayout {
+  const next = clampWidth(width, viewportWidth);
+  return next === 0
+    ? { width: 0, expandedWidth: layout.expandedWidth }
+    : { width: next, expandedWidth: next };
+}
+
+export function toggleCollapsed(layout: SidebarLayout, viewportWidth: number): SidebarLayout {
+  return isCollapsed(layout)
+    ? resizeTo(layout, layout.expandedWidth, viewportWidth)
+    : { width: 0, expandedWidth: layout.expandedWidth };
+}
+
+/** Keyboard resize. Expanding from collapsed jumps straight to the remembered
+ *  width - stepping 16px at a time out of 0 would take ten presses to show
+ *  anything, because everything below the threshold is still collapsed. */
+export function nudge(layout: SidebarLayout, delta: number, viewportWidth: number): SidebarLayout {
+  if (isCollapsed(layout)) {
+    return delta > 0 ? resizeTo(layout, layout.expandedWidth, viewportWidth) : layout;
+  }
+  return resizeTo(layout, layout.width + delta, viewportWidth);
+}
+
+export interface DragOrigin {
+  /** Pointer x where the drag started. */
+  x: number;
+  /** Pane width when the drag started. 0 when it started collapsed. */
+  width: number;
+}
+
+/** Width the pointer is currently asking for. The handle sits to the RIGHT of
+ *  the pane, so moving right widens it one-to-one; clamping happens on the way
+ *  into state, not here, so the value stays a pure function of the gesture. */
+export function widthFromDrag(origin: DragOrigin, clientX: number): number {
+  return origin.width + (clientX - origin.x);
+}
+
+export function parseLayout(raw: string | null, viewportWidth: number): SidebarLayout {
+  if (!raw) return defaultLayout(viewportWidth);
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!parsed || typeof parsed !== "object") return defaultLayout(viewportWidth);
+    return normalize(parsed as Partial<SidebarLayout>, viewportWidth);
+  } catch {
+    return defaultLayout(viewportWidth);
+  }
+}
+
+export function readLayout(storage: SidebarStorage, viewportWidth: number): SidebarLayout {
+  try {
+    return parseLayout(storage.getItem(SIDEBAR_LAYOUT_STORAGE_KEY), viewportWidth);
+  } catch {
+    // Private-mode Safari throws on access, and a preference is never worth a crash.
+    return defaultLayout(viewportWidth);
+  }
+}
+
+export function writeLayout(storage: SidebarStorage, layout: SidebarLayout): void {
+  try {
+    storage.setItem(SIDEBAR_LAYOUT_STORAGE_KEY, JSON.stringify(layout));
+  } catch {
+    // Quota or private mode. The width still works for this session.
+  }
+}
