diff --git a/apps/web/src/use-sidebar-width.ts b/apps/web/src/use-sidebar-width.ts
new file mode 100644
index 0000000..12b108b
--- /dev/null
+++ b/apps/web/src/use-sidebar-width.ts
@@ -0,0 +1,78 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import {
+  defaultLayout,
+  normalize,
+  nudge,
+  readLayout,
+  resizeTo,
+  toggleCollapsed,
+  writeLayout,
+  type SidebarLayout,
+} from "./lib/sidebar-width.js";
+
+const isBrowser = typeof window !== "undefined";
+/** Only used when there is no window (tests, SSR): wide enough not to clamp. */
+const ASSUMED_VIEWPORT = 1440;
+/** A drag fires pointermove ~60x/s; persisting each one would be pointless churn. */
+const PERSIST_DEBOUNCE_MS = 250;
+
+function viewportWidth(): number {
+  return isBrowser ? window.innerWidth : ASSUMED_VIEWPORT;
+}
+
+export interface SidebarWidthControls {
+  layout: SidebarLayout;
+  /** Absolute width in px, from a drag. Clamped and snapped by the caller's state. */
+  resize: (width: number) => void;
+  /** Relative width change in px, from the keyboard. */
+  nudgeBy: (delta: number) => void;
+  /** Collapse an open pane, or restore the remembered width. */
+  toggle: () => void;
+}
+
+/** Owns the conversation-list width: reads the stored preference once, keeps it
+ *  inside the current window, and persists changes after the drag settles. */
+export function useSidebarWidth(): SidebarWidthControls {
+  const [layout, setLayout] = useState<SidebarLayout>(() =>
+    isBrowser ? readLayout(window.localStorage, viewportWidth()) : defaultLayout(ASSUMED_VIEWPORT),
+  );
+
+  const firstRender = useRef(true);
+  useEffect(() => {
+    if (firstRender.current) {
+      firstRender.current = false;
+      return;
+    }
+    if (!isBrowser) return;
+    const timer = window.setTimeout(() => writeLayout(window.localStorage, layout), PERSIST_DEBOUNCE_MS);
+    return () => window.clearTimeout(timer);
+  }, [layout]);
+
+  // Moving the window to a narrower screen must not leave the list wider than
+  // the reading pane. Re-clamping returns the same object when nothing moves,
+  // so this does not re-render on every resize frame.
+  useEffect(() => {
+    if (!isBrowser) return;
+    const onResize = () =>
+      setLayout((prev) => {
+        const next = normalize(prev, window.innerWidth);
+        return next.width === prev.width && next.expandedWidth === prev.expandedWidth ? prev : next;
+      });
+    window.addEventListener("resize", onResize);
+    return () => window.removeEventListener("resize", onResize);
+  }, []);
+
+  const resize = useCallback((width: number) => {
+    setLayout((prev) => resizeTo(prev, width, viewportWidth()));
+  }, []);
+
+  const nudgeBy = useCallback((delta: number) => {
+    setLayout((prev) => nudge(prev, delta, viewportWidth()));
+  }, []);
+
+  const toggle = useCallback(() => {
+    setLayout((prev) => toggleCollapsed(prev, viewportWidth()));
+  }, []);
+
+  return { layout, resize, nudgeBy, toggle };
+}
