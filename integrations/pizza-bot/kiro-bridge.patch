+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+import { SidebarResizer } from "./SidebarResizer.js";
+
+const noop = vi.fn();
+
+function render(width: number): string {
+  return renderToStaticMarkup(
+    <SidebarResizer
+      layout={{ width, expandedWidth: width === 0 ? 480 : width }}
+      onResize={noop}
+      onNudge={noop}
+      onToggle={noop}
+    />,
+  );
+}
+
+describe("SidebarResizer", () => {
+  it("is a focusable separator carrying the current width", () => {
+    const html = render(480);
+    expect(html).toContain('role="separator"');
+    expect(html).toContain('aria-orientation="vertical"');
+    expect(html).toContain('aria-valuenow="480"');
+    expect(html).toContain('tabindex="0"');
+  });
+
+  it("stays visible and says how to get the list back when collapsed", () => {
+    const html = render(0);
+    expect(html).toContain('data-collapsed="true"');
+    expect(html).toContain("Double-click to show the conversation list");
+  });
+
+  it("offers collapse as the double-click affordance when open", () => {
+    expect(render(320)).toContain("Drag to resize, double-click to collapse");
+  });
+});
diff --git a/apps/web/src/components/SidebarResizer.tsx b/apps/web/src/components/SidebarResizer.tsx
new file mode 100644
index 0000000..856d7c8
--- /dev/null
+++ b/apps/web/src/components/SidebarResizer.tsx
@@ -0,0 +1,93 @@
+import { useCallback, useRef, useState, type PointerEvent as ReactPointerEvent } from "react";
+import {
+  SIDEBAR_KEYBOARD_STEP,
+  SIDEBAR_MAX_WIDTH,
+  widthFromDrag,
+  type DragOrigin,
+  type SidebarLayout,
+} from "../lib/sidebar-width.js";
+
+export interface SidebarResizerProps {
+  layout: SidebarLayout;
+  onResize: (width: number) => void;
+  onNudge: (delta: number) => void;
+  onToggle: () => void;
+}
+
+/** The grab area between the conversation list and the reading pane.
+ *
+ *  Pointer capture, not window listeners: the pointer leaves this 5px strip on
+ *  the first fast drag, and capture keeps the events coming without a global
+ *  mousemove handler to leak. Keyboard works too, because a 5px target is not
+ *  the only way anyone should be able to size a pane. */
+export function SidebarResizer({ layout, onResize, onNudge, onToggle }: SidebarResizerProps) {
+  const [dragging, setDragging] = useState(false);
+  const origin = useRef<DragOrigin | null>(null);
+  const collapsed = layout.width === 0;
+
+  const onPointerDown = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      if (event.button !== 0) return;
+      event.preventDefault();
+      event.currentTarget.setPointerCapture(event.pointerId);
+      origin.current = { x: event.clientX, width: layout.width };
+      setDragging(true);
+    },
+    [layout.width],
+  );
+
+  const onPointerMove = useCallback(
+    (event: ReactPointerEvent<HTMLDivElement>) => {
+      const from = origin.current;
+      if (!from) return;
+      onResize(widthFromDrag(from, event.clientX));
+    },
+    [onResize],
+  );
+
+  const endDrag = useCallback((event: ReactPointerEvent<HTMLDivElement>) => {
+    if (!origin.current) return;
+    origin.current = null;
+    setDragging(false);
+    if (event.currentTarget.hasPointerCapture(event.pointerId)) {
+      event.currentTarget.releasePointerCapture(event.pointerId);
+    }
+  }, []);
+
+  return (
+    <div
+      role="separator"
+      aria-orientation="vertical"
+      aria-label="Resize the conversation list"
+      aria-valuenow={layout.width}
+      aria-valuemin={0}
+      aria-valuemax={SIDEBAR_MAX_WIDTH}
+      tabIndex={0}
+      title={
+        collapsed
+          ? "Double-click to show the conversation list"
+          : "Drag to resize, double-click to collapse"
+      }
+      className={`sidebar-resizer${dragging ? " dragging" : ""}`}
+      data-collapsed={collapsed ? "true" : undefined}
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={endDrag}
+      onPointerCancel={endDrag}
+      onDoubleClick={onToggle}
+      onKeyDown={(event) => {
+        const step = event.shiftKey ? SIDEBAR_KEYBOARD_STEP * 4 : SIDEBAR_KEYBOARD_STEP;
+        if (event.key === "ArrowLeft") {
+          event.preventDefault();
+          onNudge(-step);
+        } else if (event.key === "ArrowRight") {
+          event.preventDefault();
+          onNudge(step);
+        } else if (event.key === "Enter" || event.key === " ") {
+          event.preventDefault();
+          onToggle();
+        }
+      }}
+    />
+  );
+}
