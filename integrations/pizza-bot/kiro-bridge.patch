+      await kiroRoutes(f.host, { agentsDir: f.agentsDir, queueDir: f.queueDir }).request("/kiro/handoffs/pending")
+    ).json()) as { pending: Array<Record<string, unknown>> };
+    const gone = body.pending.find((p) => p.handoffId === "h-gone");
+    expect(gone).toBeDefined();
