diff --git a/apps/api-server/src/routes-kiro.ts b/apps/api-server/src/routes-kiro.ts
new file mode 100644
index 0000000..25c25c9
--- /dev/null
+++ b/apps/api-server/src/routes-kiro.ts
@@ -0,0 +1,293 @@
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdir, readFile, readdir, rename, stat, writeFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { basename, join } from "node:path";
+import { promisify } from "node:util";
+import { AIMessage, HumanMessage } from "@langchain/core/messages";
+import { Hono } from "hono";
+import type { AgentHost } from "./agent-host.js";
+
+const run = promisify(execFile);
+const TARGET = /^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$/;
+const MAX_MESSAGE = 100_000;
+
+// KiroCrew materializes a throwaway chat-companion config per opened skill view, in batches, into
+// the same directory as real agents and never removes them — hundreds accumulate within days and
+// would bury the recipient dropdown. Nobody addresses mail to a view's companion.
+const DEFAULT_EXCLUDE = /^kirocrew-skill-view-[0-9a-f]{16,}$/;
+
+function agentExcluded(name: string): boolean {
+  const custom = process.env.PIZZA_KIRO_AGENTS_EXCLUDE;
+  if (custom !== undefined) {
+    if (custom === "") return false;
+    try {
+      return new RegExp(custom).test(name);
+    } catch {
+      // An unparseable override must not silently widen the list back to the noise.
+      return DEFAULT_EXCLUDE.test(name);
+    }
+  }
+  return DEFAULT_EXCLUDE.test(name);
+}
+
+interface BridgeDeps {
+  agentsDir: string;
+  queueDir: string;
+  dispatch: (target: string, message: string, threadId: string, requestId?: string) => Promise<string>;
+}
+
+export function kiroRoutes(host: AgentHost, overrides: Partial<BridgeDeps> = {}): Hono {
+  const agentsDir = overrides.agentsDir ?? process.env.PIZZA_KIRO_AGENTS_DIR ?? join(homedir(), ".kiro", "agents");
+  const dispatch = overrides.dispatch ?? defaultDispatch;
+  const queueDir =
+    overrides.queueDir ?? process.env.PIZZA_KIRO_QUEUE_DIR ?? join(homedir(), ".kiro", "agents-state", "queue");
+  const app = new Hono();
+
+  app.get("/kiro/agents", async (c) => {
+    const agents = [];
+    for (const entry of await readdir(agentsDir, { withFileTypes: true }).catch(() => [])) {
+      if (!entry.isFile() || !entry.name.endsWith(".json")) continue;
+      const name = basename(entry.name, ".json");
+      if (!TARGET.test(name) || agentExcluded(name)) continue;
+      try {
+        const parsed = JSON.parse(await readFile(join(agentsDir, entry.name), "utf8")) as Record<string, unknown>;
+        agents.push({
+          name,
+          cliName: typeof parsed.name === "string" ? parsed.name : name,
+          description: typeof parsed.description === "string" ? parsed.description : "",
+        });
+      } catch {
+        // Invalid configs are not routable and stay visible in the Agent Dashboard health view.
+      }
+    }
+    agents.sort((a, b) => a.name.localeCompare(b.name));
+    return c.json({ agents });
+  });
+
+  // The pending directory is the source of truth: the return watcher moves a mapping out of it the
+  // moment it delivers, so a derived view can never claim a handoff is outstanding after it landed.
+  // Duplicating this into the thread record would be a second copy free to drift.
+  app.get("/kiro/handoffs/pending", async (c) => {
+    const dir = join(host.dataRoot, "bridge", "pending");
+    const pending = [];
+    for (const entry of await readdir(dir, { withFileTypes: true }).catch(() => [])) {
+      if (!entry.isFile() || !entry.name.endsWith(".json")) continue;
+      try {
+        const parsed = JSON.parse(await readFile(join(dir, entry.name), "utf8")) as Record<string, unknown>;
+        const handoffId = validText(parsed.handoffId, 200);
+        const threadId = validText(parsed.threadId, 200);
+        const target = validText(parsed.target, 100);
+        // writeMapping renames into place, but a foreign writer could leave a partial file.
+        if (!handoffId || !threadId || !target) continue;
+        pending.push({ handoffId, threadId, target, requestedAt: validText(parsed.requestedAt, 40) });
+      } catch {
+        // Unreadable mapping: the handoff may well be in flight, but nothing here can say to whom.
+      }
+    }
+    pending.sort((a, b) => (a.requestedAt ?? "").localeCompare(b.requestedAt ?? ""));
+    const states = await queueStates(queueDir);
+    return c.json({
+      pending: pending.map((item) => ({ ...item, ...(states.get(item.handoffId) ?? {}) })),
+    });
+  });
+
+  app.post("/kiro/handoffs", async (c) => {
+    const raw = (await c.req.json().catch(() => ({}))) as Record<string, unknown>;
+    const target = validText(raw.target, 100);
+    const message = validText(raw.message, MAX_MESSAGE);
+    const threadId = validText(raw.threadId, 200);
+    const requestId = validText(raw.requestId, 200);
+    if (!target || !TARGET.test(target) || !message || !threadId) {
+      return c.json({ error: "target, message and threadId are required" }, 400);
+    }
+    if (!(await agentExists(agentsDir, target))) return c.json({ error: "target agent not found" }, 404);
+
+    const handoffId = await dispatch(target, message, threadId, requestId);
+    await writeMapping(host.dataRoot, {
+      handoffId,
+      threadId,
+      target,
+      requestedAt: new Date().toISOString(),
+    });
+    await appendOnce(
+      host,
+      threadId,
+      new HumanMessage({ id: `kiro_request_${handoffId}`, content: `**To: ${target}**\n\n${message}` }),
+    );
+    const record = host.threadStore.ensure({
+      threadId,
+      title: `To ${target}: ${message.slice(0, 80)}`,
+      source: "user",
+    });
+    // Mail semantics: sending files the conversation under Sent instead of leaving it in the inbox.
+    // The user is not expected to sit on an open thread; the reply brings it back.
+    host.threadStore.update(threadId, {
+      title: record.title === "New conversation" ? `To ${target}: ${message.slice(0, 80)}` : record.title,
+      lastMessage: message.slice(0, 500),
+      lastMessageRole: "human",
+      unread: false,
+      folderId: ensureFolder(host, "Sent").folderId,
+    });
+    host.threadStore.touch(threadId);
+    return c.json({ accepted: true, handoffId, target, threadId }, 202);
+  });
+
+  app.post("/kiro/responses", async (c) => {
+    const raw = (await c.req.json().catch(() => ({}))) as Record<string, unknown>;
+    const handoffId = validText(raw.handoffId, 200);
+    const threadId = validText(raw.threadId, 200);
+    const target = validText(raw.target, 100);
+    const result = validText(raw.result, MAX_MESSAGE);
+    const status = validText(raw.status, 30);
+    const needsInput = raw.needsInput === true || status === "failed" || status === "deferred";
+    if (!handoffId || !threadId || !target || !result || !status) {
+      return c.json({ error: "handoffId, threadId, target, result and status are required" }, 400);
+    }
+    const existing = host.threadStore.get(threadId);
+    if (!existing) {
+      return c.json({ created: false, threadId, handoffId, orphaned: true });
+    }
+
+    const created = await appendOnce(
+      host,
+      threadId,
+      new AIMessage({
+        id: `kiro_response_${handoffId}`,
+        content: `**From: ${target}**\n**Status: ${status}**\n\n${result}`,
+      }),
+    );
+    const patch: Record<string, unknown> = {
+      unread: true,
+      lastMessage: result.slice(0, 500),
+      lastMessageRole: "ai",
+    };
+    const sent = host.folderStore.list().find((folder) => folder.name === "Sent");
+    if (needsInput) {
+      patch.folderId = ensureFolder(host, "Action Required").folderId;
+    } else if (sent && existing.folderId === sent.folderId) {
+      // The reply returns the conversation to the inbox — but only out of Sent, so a thread the
+      // user filed somewhere on purpose is not yanked back.
+      patch.folderId = null;
+    }
+    host.threadStore.update(threadId, patch);
+    host.threadStore.touch(threadId);
+    return c.json({ created, threadId, handoffId });
+  });
+
+  return app;
+}
+
+async function defaultDispatch(
+  target: string,
+  message: string,
+  threadId: string,
+  requestId?: string,
+): Promise<string> {
+  const script = process.env.PIZZA_KIRO_HANDOFF ?? join(homedir(), ".kiro", "agents", "scripts", "handoff.sh");
+  const key = createHash("sha256")
+    .update(`${threadId}\0${target}\0${message}\0${requestId ?? "legacy"}`)
+    .digest("hex");
+  const input = JSON.stringify({
+    thread_id: threadId,
+    request: message,
+    response_contract: "Final line MUST be PIZZA_RESPONSE|status=DONE|result=<concise answer> or PIZZA_RESPONSE|status=NEEDS_INPUT|result=<required action>. Keep it under 500 characters.",
+  });
+  const { stdout } = await run(
+    script,
+    [
+      "pizza-bot",
+      target,
+      "pizza-direct-message",
+      input,
+      "900",
+      "Complete result in PIZZA_RESPONSE contract returned to the Pizza thread.",
+      "^[[:space:]]*>[[:space:]]*PIZZA_RESPONSE\\|status=(DONE|NEEDS_INPUT)\\|result=",
+      `pizza-${key}`,
+      "2",
+    ],
+    { timeout: 15_000, maxBuffer: 64 * 1024 },
+  );
+  const id = stdout.trim().split(/\s+/).at(-1);
+  if (!id || !/^h[0-9]+$/.test(id)) throw new Error("handoff.sh returned no valid id");
+  return id;
+}
+
+interface QueueState {
+  queueState: "queued" | "running";
+  /** A2A items the worker will start before this one; it drains oldest-created first. */
+  ahead?: number;
+  /** When the dispatcher claimed the item, read from the running file's mtime. */
+  startedAt?: string;
+}
+
+/**
+ * Where each outstanding handoff sits in the delivery queue, so the inbox can say "queued, 2 ahead"
+ * instead of an undifferentiated wait. Best-effort by design: the queue is another process's
+ * directory, and anything unreadable simply yields no state rather than a wrong one.
+ */
+async function queueStates(queueDir: string): Promise<Map<string, QueueState>> {
+  const states = new Map<string, QueueState>();
+  const queued: Array<{ id: string; created: string }> = [];
+  for (const entry of await readdir(join(queueDir, "pending"), { withFileTypes: true }).catch(() => [])) {
+    if (!entry.isFile() || !entry.name.endsWith(".json")) continue;
+    try {
+      const item = JSON.parse(await readFile(join(queueDir, "pending", entry.name), "utf8")) as Record<string, unknown>;
+      const params = (item.params ?? {}) as Record<string, unknown>;
+      if (params.source !== "a2a-handoff" || item.needsInput) continue;
+      queued.push({ id: String(item.id ?? basename(entry.name, ".json")), created: String(item.created ?? "") });
+    } catch {
+      // A partial write from the producer; it will be readable on the next poll.
+    }
+  }
+  queued.sort((a, b) => a.created.localeCompare(b.created));
+  queued.forEach((item, index) => states.set(item.id, { queueState: "queued", ahead: index }));
+  for (const entry of await readdir(join(queueDir, "running"), { withFileTypes: true }).catch(() => [])) {
+    if (!entry.isFile() || !entry.name.endsWith(".json")) continue;
+    try {
+      const info = await stat(join(queueDir, "running", entry.name));
+      states.set(basename(entry.name, ".json"), { queueState: "running", startedAt: info.mtime.toISOString() });
+    } catch {
+      // Finished between readdir and stat: no longer running, and the next poll will say so.
+    }
+  }
+  return states;
+}
+
+async function agentExists(root: string, target: string): Promise<boolean> {
+  try {
+    const parsed = JSON.parse(await readFile(join(root, `${target}.json`), "utf8")) as Record<string, unknown>;
+    return typeof parsed.name === "string";
+  } catch {
+    return false;
+  }
+}
+
+async function writeMapping(dataRoot: string, value: Record<string, unknown>): Promise<void> {
+  const dir = join(dataRoot, "bridge", "pending");
+  await mkdir(dir, { recursive: true });
+  const target = join(dir, `${value.handoffId}.json`);
+  const tmp = `${target}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(value, null, 2), { mode: 0o600 });
+  await rename(tmp, target);
+}
+
+async function appendOnce(host: AgentHost, threadId: string, message: AIMessage | HumanMessage): Promise<boolean> {
+  await host.whenReady();
+  const state = await host.agent.getState(threadId);
+  const messages = (state.values as { messages?: Array<{ id?: string }> } | undefined)?.messages ?? [];
+  if (messages.some((item) => item.id === message.id)) return false;
+  await host.agent.updateState(threadId, { messages: [message] });
+  return true;
+}
+
+function ensureFolder(host: AgentHost, name: string) {
+  const existing = host.folderStore.list().find((folder) => folder.name === name);
+  return existing ?? host.folderStore.create({ folderId: createHash("sha256").update(name).digest("hex").slice(0, 32), name });
+}
+
+function validText(value: unknown, max: number): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const result = value.trim();
+  return result.length > 0 && result.length <= max ? result : undefined;
+}
