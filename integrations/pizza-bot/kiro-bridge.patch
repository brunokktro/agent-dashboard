+import { describe, expect, it } from "vitest";
+import {
+  DASHBOARD_THEME_MESSAGE,
+  dashboardOriginFromReferrer,
+  embeddedTheme,
+  isAllowedDashboardOrigin,
+} from "./embedded-theme.js";
+
+describe("embedded dashboard theme", () => {
+  it("accepts only the loopback Agent Dashboard origins", () => {
+    expect(isAllowedDashboardOrigin("http://127.0.0.1:7780")).toBe(true);
+    expect(isAllowedDashboardOrigin("http://localhost:7780")).toBe(true);
+    expect(isAllowedDashboardOrigin("http://127.0.0.1:7781")).toBe(false);
+    expect(isAllowedDashboardOrigin("https://evil.example")).toBe(false);
+  });
+
+  it("accepts only explicit light or dark messages", () => {
+    expect(
+      embeddedTheme({
+        origin: "http://127.0.0.1:7780",
+        data: { type: DASHBOARD_THEME_MESSAGE, theme: "light" },
+      }),
+    ).toBe("light");
+    expect(
+      embeddedTheme({
+        origin: "http://127.0.0.1:7780",
+        data: { type: DASHBOARD_THEME_MESSAGE, theme: "system" },
+      }),
+    ).toBeUndefined();
+    expect(
+      embeddedTheme({
+        origin: "https://evil.example",
+        data: { type: DASHBOARD_THEME_MESSAGE, theme: "dark" },
+      }),
+    ).toBeUndefined();
+  });
+
+  it("targets readiness only to a validated Dashboard referrer", () => {
+    expect(dashboardOriginFromReferrer("http://127.0.0.1:7780/pizza")).toBe(
+      "http://127.0.0.1:7780",
+    );
+    expect(dashboardOriginFromReferrer("https://evil.example/embed")).toBeUndefined();
+    expect(dashboardOriginFromReferrer("not a URL")).toBeUndefined();
+  });
+});
diff --git a/apps/web/src/embedded-theme.ts b/apps/web/src/embedded-theme.ts
new file mode 100644
index 0000000..e335442
--- /dev/null
+++ b/apps/web/src/embedded-theme.ts
@@ -0,0 +1,52 @@
+import { applyTheme, THEME_STORAGE_KEY, type ResolvedTheme } from "./theme-storage.js";
+
+export const DASHBOARD_THEME_MESSAGE = "agent-dashboard-theme";
+
+export function isAllowedDashboardOrigin(origin: string): boolean {
+  return origin === "http://127.0.0.1:7780" || origin === "http://localhost:7780";
+}
+
+export function embeddedTheme(event: Pick<MessageEvent, "origin" | "data">): ResolvedTheme | undefined {
+  if (!isAllowedDashboardOrigin(event.origin)) return undefined;
+  if (!event.data || event.data.type !== DASHBOARD_THEME_MESSAGE) return undefined;
+  return event.data.theme === "light" || event.data.theme === "dark" ? event.data.theme : undefined;
+}
+
+export function dashboardOriginFromReferrer(referrer: string): string | undefined {
+  try {
+    const origin = new URL(referrer).origin;
+    return isAllowedDashboardOrigin(origin) ? origin : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export function installEmbeddedThemeBridge(): () => void {
+  if (window.parent === window) return () => undefined;
+  let forced: ResolvedTheme | undefined;
+
+  const apply = (theme: ResolvedTheme) => {
+    forced = theme;
+    window.localStorage.setItem(THEME_STORAGE_KEY, theme);
+    applyTheme(theme);
+  };
+  const onMessage = (event: MessageEvent) => {
+    const theme = embeddedTheme(event);
+    if (theme) apply(theme);
+  };
+  window.addEventListener("message", onMessage);
+
+  const observer = new MutationObserver(() => {
+    if (!forced) return;
+    const current = document.documentElement.classList.contains("light") ? "light" : "dark";
+    if (current !== forced) queueMicrotask(() => applyTheme(forced!));
+  });
+  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
+  const parentOrigin = dashboardOriginFromReferrer(document.referrer);
+  if (parentOrigin) window.parent.postMessage({ type: "pizza-theme-ready" }, parentOrigin);
+
+  return () => {
+    observer.disconnect();
+    window.removeEventListener("message", onMessage);
+  };
+}
