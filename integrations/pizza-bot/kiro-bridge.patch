+describe("GET /kiro/agents: ephemeral companions stay out of the dropdown", () => {
+  afterEach(() => {
+    delete process.env.PIZZA_KIRO_AGENTS_EXCLUDE;
+  });
+
+  async function seedCompanions(agentsDir: string) {
+    const { writeFile: wf } = await import("node:fs/promises");
+    for (const name of [
+      "kirocrew-skill-view-0027b6ebf7c4fc921aab4e71",
+      "kirocrew-skill-view-f4f65391f8b77e17d0d86d85",
+    ]) {
+      await wf(join(agentsDir, `${name}.json`), JSON.stringify({ name, description: "companion" }));
+    }
+    await wf(
+      join(agentsDir, "kirocrew-conductor.json"),
+      JSON.stringify({ name: "kirocrew-conductor", description: "real" }),
+    );
+  }
+
+  it("hides skill-view companions but keeps real kirocrew agents", async () => {
+    const f = await fixture();
+    await seedCompanions(f.agentsDir);
+    const response = await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/agents");
+    const body = (await response.json()) as { agents: Array<{ name: string }> };
+    const names = body.agents.map((agent) => agent.name);
+    expect(names).toContain("kirocrew-conductor");
+    expect(names).toContain("demo-agent");
+    expect(names.some((name) => name.startsWith("kirocrew-skill-view-"))).toBe(false);
+  });
+
+  it("an operator override replaces the default pattern", async () => {
+    const f = await fixture();
+    await seedCompanions(f.agentsDir);
+    process.env.PIZZA_KIRO_AGENTS_EXCLUDE = "^kirocrew-";
+    const body = (await (await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/agents")).json()) as {
+      agents: Array<{ name: string }>;
+    };
+    const names = body.agents.map((agent) => agent.name);
+    expect(names).toContain("demo-agent");
+    expect(names.some((name) => name.startsWith("kirocrew-"))).toBe(false);
+  });
+
+  it("an empty override disables filtering entirely", async () => {
+    const f = await fixture();
+    await seedCompanions(f.agentsDir);
+    process.env.PIZZA_KIRO_AGENTS_EXCLUDE = "";
+    const body = (await (await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/agents")).json()) as {
+      agents: Array<{ name: string }>;
+    };
+    expect(body.agents.some((agent) => agent.name.startsWith("kirocrew-skill-view-"))).toBe(true);
+  });
+
+  it("a broken override regex falls back to the default filter, not to the noise", async () => {
+    const f = await fixture();
+    await seedCompanions(f.agentsDir);
+    process.env.PIZZA_KIRO_AGENTS_EXCLUDE = "([";
+    const body = (await (await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/agents")).json()) as {
+      agents: Array<{ name: string }>;
+    };
+    const names = body.agents.map((agent) => agent.name);
+    expect(names.some((name) => name.startsWith("kirocrew-skill-view-"))).toBe(false);
+    expect(names).toContain("kirocrew-conductor");
+  });
+});
