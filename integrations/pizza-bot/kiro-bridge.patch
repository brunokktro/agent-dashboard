+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    const accepted = await routes.request("/kiro/handoffs", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ target: "demo-agent", message: "oi", threadId: "t-live" }),
+    });
+    expect(accepted.status).toBe(202);
+
+    const response = await routes.request("/kiro/handoffs/pending");
+    const body = (await response.json()) as { pending: Array<Record<string, unknown>> };
+    expect(body.pending).toHaveLength(1);
+    expect(body.pending[0]).toMatchObject({ handoffId: "h123456", threadId: "t-live", target: "demo-agent" });
+    expect(typeof body.pending[0]?.requestedAt).toBe("string");
