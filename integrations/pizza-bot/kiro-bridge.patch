+
+  it("still reports the mapping right after a response, because the watcher owns the move", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await routes.request("/kiro/handoffs", {
