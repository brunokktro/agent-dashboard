+import { describe, expect, it } from "vitest";
+import { awaitingByThread, awaitingLabel } from "./awaiting.js";
+
+const thread = (threadId: string, lastMessageRole?: string) => ({ threadId, lastMessageRole });
+
+describe("awaitingByThread", () => {
+  it("marks a thread whose handoff is outstanding and whose last word was the user's", () => {
+    const result = awaitingByThread(
+      [{ handoffId: "h1", threadId: "t1", target: "second-agent", requestedAt: "2026-09-21T10:00:00.000Z" }],
+      [thread("t1", "human")],
+    );
+    expect(result.get("t1")).toEqual({
+      target: "second-agent",
+      handoffId: "h1",
+      requestedAt: "2026-09-21T10:00:00.000Z",
+      count: 1,
+    });
+  });
+
+  it("does not mark a thread whose response already landed, even while the mapping lingers", () => {
+    const result = awaitingByThread(
+      [{ handoffId: "h1", threadId: "t1", target: "second-agent", requestedAt: "2026-09-21T10:00:00.000Z" }],
+      [thread("t1", "ai")],
+    );
+    expect(result.has("t1")).toBe(false);
+  });
+
+  it("ignores a mapping for a thread the client does not know", () => {
+    const result = awaitingByThread(
+      [{ handoffId: "h1", threadId: "gone", target: "second-agent" }],
+      [thread("t1", "human")],
+    );
+    expect(result.size).toBe(0);
+  });
+
+  it("ignores a thread with no messages yet", () => {
+    const result = awaitingByThread([{ handoffId: "h1", threadId: "t1", target: "x" }], [thread("t1", undefined)]);
+    expect(result.has("t1")).toBe(false);
+  });
+
+  it("reports the oldest target and counts every outstanding handoff on the thread", () => {
+    const result = awaitingByThread(
+      [
+        { handoffId: "h-new", threadId: "t1", target: "review-agent", requestedAt: "2026-09-21T11:00:00.000Z" },
+        { handoffId: "h-old", threadId: "t1", target: "demo-agent", requestedAt: "2026-09-21T09:00:00.000Z" },
+        { handoffId: "h-mid", threadId: "t1", target: "reporting-agent", requestedAt: "2026-09-21T10:00:00.000Z" },
+      ],
+      [thread("t1", "human")],
+    );
+    expect(result.get("t1")).toEqual({
+      target: "demo-agent",
+      handoffId: "h-old",
+      requestedAt: "2026-09-21T09:00:00.000Z",
+      count: 3,
+    });
+  });
+
+  it("prefers a dated mapping over an undated one, whatever the arrival order", () => {
+    const dated = { handoffId: "h-dated", threadId: "t1", target: "dated", requestedAt: "2026-09-21T09:00:00.000Z" };
+    const undated = { handoffId: "h-undated", threadId: "t1", target: "undated" };
+    for (const pending of [[undated, dated], [dated, undated]]) {
+      const result = awaitingByThread(pending, [thread("t1", "human")]);
+      expect(result.get("t1")).toMatchObject({ target: "dated", handoffId: "h-dated", count: 2 });
+    }
+  });
+
+  it("keeps threads independent", () => {
