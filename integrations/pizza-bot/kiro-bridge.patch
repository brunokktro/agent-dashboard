+      [
+        { handoffId: "", threadId: "t1", target: "a" },
+        { handoffId: "h2", threadId: "", target: "a" },
+        { handoffId: "h3", threadId: "t1", target: "" },
+      ],
+      [thread("t1", "human")],
+    );
+    expect(result.size).toBe(0);
