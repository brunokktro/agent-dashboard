+    expect(() => writeLayout(storage, defaultLayout(WIDE))).not.toThrow();
+    expect(readLayout(storage, WIDE)).toEqual(defaultLayout(WIDE));
+  });
+});
diff --git a/apps/web/src/lib/sidebar-width.ts b/apps/web/src/lib/sidebar-width.ts
