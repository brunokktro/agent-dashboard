+        { handoffId: "h1", threadId: "t1", target: "a", requestedAt: "2026-09-21T09:00:00.000Z" },
+        { handoffId: "h2", threadId: "t2", target: "b", requestedAt: "2026-09-21T09:30:00.000Z" },
+        { handoffId: "h3", threadId: "t3", target: "c", requestedAt: "2026-09-21T09:40:00.000Z" },
+      ],
+      [thread("t1", "human"), thread("t2", "ai"), thread("t3", "human")],
+    );
+    expect([...result.keys()].sort()).toEqual(["t1", "t3"]);
+  });
+
+  it("drops malformed mappings instead of rendering a badge with no target", () => {
