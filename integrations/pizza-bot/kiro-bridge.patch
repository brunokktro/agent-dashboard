+import { describe, expect, it, vi } from "vitest";
+import type { AgentHost } from "./agent-host.js";
+import { notificationRoutes } from "./routes-notifications.js";
+
+function fakeHost() {
+  const threads = new Map<string, Record<string, unknown>>();
+  const folders: Array<{ folderId: string; name: string }> = [];
+  const updateState = vi.fn(async () => ({ checkpointId: "cp-1", threadId: "thread" }));
+  const reindexThread = vi.fn();
+  const host = {
+    whenReady: vi.fn(async () => undefined),
+    agent: { updateState },
+    threadStore: {
+      get: (id: string) => threads.get(id),
+      create: (input: Record<string, unknown>) => {
+        const row = { ...input, unread: false, awaitingAction: false };
+        threads.set(String(input.threadId), row);
+        return row;
+      },
+      update: (id: string, patch: Record<string, unknown>) => {
+        const row = { ...threads.get(id), ...patch };
+        threads.set(id, row);
+        return row;
+      },
+      touch: vi.fn(),
+    },
+    folderStore: {
+      list: () => folders,
+      create: (input: { folderId: string; name: string }) => {
+        folders.push(input);
+        return input;
+      },
+    },
+    search: { reindexThread },
+    deleteThread: vi.fn(async (id: string) => threads.delete(id)),
+  } as unknown as AgentHost;
+  return { host, threads, folders, updateState, reindexThread };
+}
+
+const payload = {
+  title: "Report ready",
+  body: "The weekly report was published.",
+  source: "reporting-agent",
+  severity: "info",
+  requiresAction: false,
+  idempotencyKey: "reporting-agent:report:2026-09-17",
+  link: "http://127.0.0.1:7781/private/report",
+};
+
+describe("notificationRoutes", () => {
+  it("creates one unread thread without invoking a model", async () => {
+    const f = fakeHost();
+    const app = notificationRoutes(f.host);
+
+    const response = await app.request("/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+
+    expect(response.status).toBe(201);
+    const body = (await response.json()) as {
+      created: boolean;
+      thread: { unread: boolean; awaitingAction: boolean; title: string; pinned: boolean };
+    };
+    expect(body.created).toBe(true);
+    expect(body.thread.unread).toBe(true);
+    expect(body.thread.awaitingAction).toBe(false);
+    expect(f.updateState).toHaveBeenCalledOnce();
+    expect(f.reindexThread).toHaveBeenCalledOnce();
+    expect(f.folders[0]?.name).toBe("Agent Updates");
+  });
+
+  it("deduplicates by business id before writing state", async () => {
+    const f = fakeHost();
+    const app = notificationRoutes(f.host);
+    const request = () =>
+      app.request("/notifications", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(payload),
+      });
+
+    expect((await request()).status).toBe(201);
+    const duplicate = await request();
+
+    expect(duplicate.status).toBe(200);
+    expect(((await duplicate.json()) as { created: boolean }).created).toBe(false);
+    expect(f.updateState).toHaveBeenCalledOnce();
+  });
+
+  it("routes action notices to a separate folder and prefixes the title", async () => {
+    const f = fakeHost();
+    const response = await notificationRoutes(f.host).request("/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...payload, requiresAction: true, severity: "critical" }),
+    });
+
+    const body = (await response.json()) as {
+      created: boolean;
+      thread: { unread: boolean; awaitingAction: boolean; title: string; pinned: boolean };
+    };
+    expect(response.status).toBe(201);
+    expect(body.thread.title).toBe("[ACTION] Report ready");
+    expect(body.thread.pinned).toBe(true);
+    expect(f.folders[0]?.name).toBe("Action Required");
+  });
+
+  it("rejects incomplete payloads and unsafe links", async () => {
+    const f = fakeHost();
+    const app = notificationRoutes(f.host);
+    const missing = await app.request("/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: "{}",
+    });
+    const unsafe = await app.request("/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ ...payload, link: "file:///etc/passwd" }),
+    });
+
+    expect(missing.status).toBe(400);
+    expect(unsafe.status).toBe(400);
+  });
+
+  it("removes the empty thread when state persistence fails", async () => {
+    const f = fakeHost();
+    vi.mocked(f.host.agent.updateState).mockRejectedValueOnce(new Error("checkpoint failed"));
+
+    const response = await notificationRoutes(f.host).request("/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(payload),
+    });
+
+    expect(response.status).toBe(500);
+    expect(f.threads.size).toBe(0);
+  });
+});
diff --git a/apps/api-server/src/routes-notifications.ts b/apps/api-server/src/routes-notifications.ts
new file mode 100644
index 0000000..9f69d2c
--- /dev/null
+++ b/apps/api-server/src/routes-notifications.ts
@@ -0,0 +1,96 @@
+import { createHash, randomUUID } from "node:crypto";
+import { AIMessage } from "@langchain/core/messages";
+import { Hono } from "hono";
+import type { AgentHost } from "./agent-host.js";
+
+const MAX_TITLE = 160;
+const MAX_BODY = 20_000;
+const SEVERITIES = new Set(["info", "warning", "critical"]);
+
+export function notificationRoutes(host: AgentHost): Hono {
+  const app = new Hono();
+
+  app.post("/notifications", async (c) => {
+    const raw = (await c.req.json().catch(() => ({}))) as Record<string, unknown>;
+    const title = text(raw.title, MAX_TITLE);
+    const body = text(raw.body, MAX_BODY);
+    const source = text(raw.source, 100);
+    const idempotencyKey = text(raw.idempotencyKey, 500);
+    const severity = typeof raw.severity === "string" ? raw.severity : "info";
+    const requiresAction = raw.requiresAction === true;
+    const link = optionalHttpUrl(raw.link);
+
+    if (!title || !body || !source || !idempotencyKey || !SEVERITIES.has(severity)) {
+      return c.json(
+        { error: "title, body, source, idempotencyKey and a valid severity are required" },
+        400,
+      );
+    }
+    if (raw.link != null && link === undefined) {
+      return c.json({ error: "link must be an http(s) URL" }, 400);
+    }
+
+    const digest = createHash("sha256").update(idempotencyKey).digest("hex");
+    const threadId = `notification_${digest.slice(0, 24)}`;
+    const existing = host.threadStore.get(threadId);
+    if (existing) return c.json({ created: false, thread: existing });
+
+    await host.whenReady();
+    const folder = ensureFolder(host, requiresAction ? "Action Required" : "Agent Updates");
+    host.threadStore.create({
+      threadId,
+      title: `${requiresAction ? "[ACTION] " : ""}${title}`,
+      source: "trigger",
+      folderId: folder.folderId,
+      pinned: severity === "critical",
+    });
+
+    const content = [
+      `**Source:** ${source}`,
+      `**Severity:** ${severity}`,
+      "",
+      body,
+      ...(link ? ["", `[Open artifact](${link})`] : []),
+    ].join("\n");
+    const message = new AIMessage({ id: `notification_message_${digest.slice(0, 24)}`, content });
+
+    try {
+      await host.agent.updateState(threadId, { messages: [message] });
+      const thread = host.threadStore.update(threadId, {
+        unread: true,
+        lastMessage: body.slice(0, 500),
+        lastMessageRole: "ai",
+      });
+      host.threadStore.touch(threadId);
+      host.search.reindexThread(threadId, [message]);
+      return c.json({ created: true, thread }, 201);
+    } catch (error) {
+      await host.deleteThread(threadId);
+      throw error;
+    }
+  });
+
+  return app;
+}
+
+function ensureFolder(host: AgentHost, name: string) {
+  const existing = host.folderStore.list().find((folder) => folder.name === name);
+  return existing ?? host.folderStore.create({ folderId: randomUUID(), name });
+}
+
+function text(value: unknown, max: number): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const result = value.trim();
+  return result.length > 0 && result.length <= max ? result : undefined;
+}
+
+function optionalHttpUrl(value: unknown): string | undefined {
+  if (value == null || value === "") return undefined;
+  if (typeof value !== "string") return undefined;
+  try {
+    const parsed = new URL(value);
+    return parsed.protocol === "http:" || parsed.protocol === "https:" ? parsed.toString() : undefined;
+  } catch {
+    return undefined;
+  }
+}
