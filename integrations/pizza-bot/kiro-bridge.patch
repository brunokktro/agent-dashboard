+    ).toBe("Waiting for reporting-agent · 3m · 3 sent");
+  });
+
+  it("never says '1 sent', which would read as a defect", () => {
+    expect(awaitingLabel({ target: "x", handoffId: "h1", count: 1 }, elapsed)).not.toContain("sent");
+  });
+});
