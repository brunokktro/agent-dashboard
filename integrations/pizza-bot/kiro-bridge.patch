+
+describe("mail semantics: Sent on send, Inbox on reply", () => {
+  const sentId = (f: Awaited<ReturnType<typeof fixture>>) =>
+    f.folders.find((folder) => folder.name === "Sent")?.folderId;
+
+  async function send(routes: ReturnType<typeof kiroRoutes>, threadId: string) {
+    return routes.request("/kiro/handoffs", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ target: "demo-agent", message: "oi", threadId }),
+    });
+  }
+
+  async function reply(
+    routes: ReturnType<typeof kiroRoutes>,
+    threadId: string,
+    extra: Record<string, unknown> = {},
+  ) {
+    return routes.request("/kiro/responses", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        handoffId: "h123456",
+        threadId,
+        target: "demo-agent",
+        status: "done",
+        result: "pronto",
+        ...extra,
+      }),
+    });
+  }
+
+  it("sending files the thread under Sent, read", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await send(routes, "t-mail");
+
+    const thread = f.threads.get("t-mail") as Record<string, unknown>;
+    expect(sentId(f)).toBeTruthy();
+    expect(thread.folderId).toBe(sentId(f));
+    expect(thread.unread).toBe(false);
+  });
+
+  it("the reply pulls the thread out of Sent back to the inbox, unread", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await send(routes, "t-mail");
+    await reply(routes, "t-mail");
+
+    const thread = f.threads.get("t-mail") as Record<string, unknown>;
+    expect(thread.folderId ?? null).toBeNull();
+    expect(thread.unread).toBe(true);
+  });
+
+  it("a reply does not yank a thread the user filed somewhere on purpose", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await send(routes, "t-filed");
+    f.host.threadStore.update("t-filed", { folderId: "my-projects" });
+    await reply(routes, "t-filed");
+
+    const thread = f.threads.get("t-filed") as Record<string, unknown>;
+    expect(thread.folderId).toBe("my-projects");
+    expect(thread.unread).toBe(true);
+  });
+
+  it("needs-input outranks Sent: the thread lands in Action Required", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await send(routes, "t-blocked");
+    await reply(routes, "t-blocked", { status: "failed", result: "precisa de login" });
+
+    const action = f.folders.find((folder) => folder.name === "Action Required")?.folderId;
+    const thread = f.threads.get("t-blocked") as Record<string, unknown>;
+    expect(thread.folderId).toBe(action);
+  });
+
+  it("replying again from the inbox re-files under Sent (a treplica leaves)", async () => {
+    const f = await fixture();
+    const routes = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    await send(routes, "t-cycle");
+    await reply(routes, "t-cycle");
+    await send(routes, "t-cycle");
+
+    const thread = f.threads.get("t-cycle") as Record<string, unknown>;
+    expect(thread.folderId).toBe(sentId(f));
+    expect(thread.unread).toBe(false);
+    expect(f.folders.filter((folder) => folder.name === "Sent")).toHaveLength(1);
+  });
+});
