+
+  it("names the target and how long it has waited", () => {
+    expect(
+      awaitingLabel({ target: "second-agent", handoffId: "h1", requestedAt: "2026-09-21T09:00:00.000Z", count: 1 }, elapsed),
+    ).toBe("Waiting for second-agent · 3m");
+  });
+
+  it("omits the elapsed part when there is no timestamp", () => {
+    expect(awaitingLabel({ target: "second-agent", handoffId: "h1", count: 1 }, elapsed)).toBe("Waiting for second-agent");
+  });
+
+  it("omits the elapsed part when the formatter cannot render one", () => {
+    expect(
+      awaitingLabel({ target: "second-agent", handoffId: "h1", requestedAt: "not-a-date", count: 1 }, elapsed),
+    ).toBe("Waiting for second-agent");
+  });
+
+  it("says how many are outstanding when the user sent again", () => {
+    expect(
