+
+  it("says the agent is working once the dispatcher claimed it", () => {
+    expect(awaitingLabel({ ...base, queueState: "running", startedAt: "2026-09-28T10:01:00Z" }, elapsed)).toBe(
+      "demo-agent is working · 3m",
+    );
+  });
+
+  it("says how many are ahead while it waits its turn", () => {
+    expect(awaitingLabel({ ...base, queueState: "queued", ahead: 2 }, elapsed)).toBe("Queued for demo-agent · 2 ahead");
+  });
+
+  it("says next when nothing is ahead", () => {
+    expect(awaitingLabel({ ...base, queueState: "queued", ahead: 0 }, elapsed)).toBe("Queued for demo-agent · next");
+  });
+
+  it("falls back to the plain wait when the queue gave no state", () => {
+    expect(awaitingLabel(base, elapsed)).toBe("Waiting for demo-agent · 3m");
+  });
+
+  it("carries queue state from the oldest outstanding handoff", () => {
+    const result = awaitingByThread(
+      [
+        { handoffId: "h-new", threadId: "t1", target: "b", requestedAt: "2026-09-28T11:00:00Z", queueState: "queued", ahead: 3 },
+        { handoffId: "h-old", threadId: "t1", target: "a", requestedAt: "2026-09-28T09:00:00Z", queueState: "running", startedAt: "x" },
+      ],
+      [{ threadId: "t1", lastMessageRole: "human" }],
+    );
+    expect(result.get("t1")).toMatchObject({ target: "a", queueState: "running", count: 2 });
+  });
+});
diff --git a/apps/web/src/projection/awaiting.ts b/apps/web/src/projection/awaiting.ts
new file mode 100644
index 0000000..4770a3c
--- /dev/null
+++ b/apps/web/src/projection/awaiting.ts
@@ -0,0 +1,112 @@
+/** Derives "sent, still waiting" per thread from the bridge's pending handoff mappings. */
+
+export interface PendingHandoffLike {
+  handoffId: string;
+  threadId: string;
+  target: string;
+  requestedAt?: string;
+  queueState?: "queued" | "running";
+  ahead?: number;
+  startedAt?: string;
+}
+
+export interface ThreadRoleLike {
+  threadId: string;
+  lastMessageRole?: string;
+}
+
+export interface AwaitingInfo {
+  /** Target of the oldest outstanding handoff, which is the one that has waited longest. */
+  target: string;
+  handoffId: string;
+  requestedAt?: string;
+  /** Outstanding handoffs on this thread; more than one means the user sent again before a reply. */
+  count: number;
+  queueState?: "queued" | "running";
+  ahead?: number;
+  startedAt?: string;
+}
+
+/**
+ * A mapping alone is not proof the thread is still waiting: the return watcher posts the response
+ * BEFORE it moves the mapping out of `pending/`, so for one cycle a delivered handoff is still
+ * listed. Requiring the last message to be the user's closes that window, since a delivered response
+ * flips `lastMessageRole` to "ai".
+ */
+export function awaitingByThread(
+  pending: readonly PendingHandoffLike[],
+  threads: readonly ThreadRoleLike[],
+): Map<string, AwaitingInfo> {
+  const roleByThread = new Map(threads.map((thread) => [thread.threadId, thread.lastMessageRole]));
+  const byThread = new Map<string, AwaitingInfo>();
+
+  for (const item of pending) {
+    if (!item.threadId || !item.target || !item.handoffId) continue;
+    // A thread the client has never heard of is not renderable, so it cannot be shown as waiting.
+    if (!roleByThread.has(item.threadId)) continue;
+    if (roleByThread.get(item.threadId) !== "human") continue;
+
+    const current = byThread.get(item.threadId);
+    if (!current) {
+      byThread.set(item.threadId, {
+        target: item.target,
+        handoffId: item.handoffId,
+        requestedAt: item.requestedAt,
+        count: 1,
+        queueState: item.queueState,
+        ahead: item.ahead,
+        startedAt: item.startedAt,
+      });
+      continue;
+    }
+    const older = isOlder(item.requestedAt, current.requestedAt);
+    const lead = older ? item : current;
+    byThread.set(item.threadId, {
+      target: lead.target,
+      handoffId: lead.handoffId,
+      requestedAt: lead.requestedAt,
+      count: current.count + 1,
+      queueState: lead.queueState,
+      ahead: lead.ahead,
+      startedAt: lead.startedAt,
+    });
+  }
+  return byThread;
+}
+
+/** A missing timestamp cannot be shown as a wait time, so a dated entry always wins. */
+function isOlder(candidate: string | undefined, incumbent: string | undefined): boolean {
+  if (!candidate) return false;
+  if (!incumbent) return true;
+  return candidate < incumbent;
+}
+
+/**
+ * Badge text for an outstanding handoff. Kept here rather than in JSX so the parts that can be wrong
+ * — a missing timestamp, a repeat send — are checkable without rendering.
+ */
+export function awaitingLabel(
+  info: AwaitingInfo,
+  formatElapsed: (iso: string) => string,
+): string {
+  // The queue position, when known, answers the question the elapsed time alone cannot: is this
+  // mail waiting its turn, or is the agent already working on it?
+  if (info.queueState === "running") {
+    const working = info.startedAt ? formatElapsed(info.startedAt) : "";
+    const parts = [`${info.target} is working`];
+    if (working) parts.push(working);
+    if (info.count > 1) parts.push(`${info.count} sent`);
+    return parts.join(" · ");
+  }
+  if (info.queueState === "queued") {
+    const parts = [`Queued for ${info.target}`];
+    parts.push(info.ahead ? `${info.ahead} ahead` : "next");
+    if (info.count > 1) parts.push(`${info.count} sent`);
+    return parts.join(" · ");
+  }
+  const parts = [`Waiting for ${info.target}`];
+  const elapsed = info.requestedAt ? formatElapsed(info.requestedAt) : "";
+  if (elapsed) parts.push(elapsed);
+  if (info.count > 1) parts.push(`${info.count} sent`);
+  return parts.join(" · ");
+}
