+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AgentHost } from "./agent-host.js";
+import { kiroRoutes } from "./routes-kiro.js";
+
+const roots: string[] = [];
+afterEach(async () => {
+  await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "pizza-kiro-route-"));
+  roots.push(root);
+  const agentsDir = join(root, "agents");
+  await import("node:fs/promises").then(({ mkdir }) => mkdir(agentsDir));
+  await writeFile(
+    join(agentsDir, "demo-agent.json"),
+    JSON.stringify({ name: "demo-agent", description: "simple" }),
+  );
+  await writeFile(join(agentsDir, "broken.json"), "{");
+
+  const messages = new Map<string, Array<{ id?: string; content?: unknown }>>();
+  const threads = new Map<string, Record<string, unknown>>();
+  const folders: Array<{ folderId: string; name: string }> = [];
+  const host = {
+    dataRoot: join(root, "data"),
+    whenReady: vi.fn(async () => undefined),
+    agent: {
+      getState: vi.fn(async (threadId: string) => ({
+        values: { messages: messages.get(threadId) ?? [] },
+      })),
+      updateState: vi.fn(async (threadId: string, values: { messages?: Array<{ id?: string }> }) => {
+        messages.set(threadId, [...(messages.get(threadId) ?? []), ...(values.messages ?? [])]);
+        return { checkpointId: "cp", threadId };
+      }),
+    },
+    threadStore: {
+      get: (id: string) => threads.get(id),
+      ensure: (input: Record<string, unknown>) => {
+        const id = String(input.threadId);
+        const row = threads.get(id) ?? { ...input, title: input.title ?? "New conversation" };
+        threads.set(id, row);
+        return row;
+      },
+      update: (id: string, patch: Record<string, unknown>) => {
+        const current = threads.get(id);
+        if (!current) return undefined;
+        const row = { ...current, ...patch };
+        threads.set(id, row);
+        return row;
+      },
+      touch: vi.fn(),
+    },
+    folderStore: {
+      list: () => folders,
+      create: (input: { folderId: string; name: string }) => {
+        folders.push(input);
+        return input;
+      },
+    },
+  } as unknown as AgentHost;
+  const dispatch = vi.fn(async () => "h123456");
+  return { root, agentsDir, host, dispatch, messages, threads, folders };
+}
+
+describe("kiroRoutes", () => {
+  it("lists only valid agent configs", async () => {
+    const f = await fixture();
+    const response = await kiroRoutes(f.host, { agentsDir: f.agentsDir }).request("/kiro/agents");
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({
+      agents: [{ name: "demo-agent", cliName: "demo-agent", description: "simple" }],
+    });
+  });
+
+  it("dispatches an exact target, persists the mapping and appends the request", async () => {
+    const f = await fixture();
+    const response = await kiroRoutes(f.host, {
+      agentsDir: f.agentsDir,
+      dispatch: f.dispatch,
+    }).request("/kiro/handoffs", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ threadId: "t1", target: "demo-agent", message: "validate", requestId: "req-1" }),
+    });
+
+    expect(response.status).toBe(202);
+    expect(f.dispatch).toHaveBeenCalledWith("demo-agent", "validate", "t1", "req-1");
+    expect(f.messages.get("t1")?.[0]?.id).toBe("kiro_request_h123456");
+    const mapping = JSON.parse(
+      await import("node:fs/promises").then(({ readFile }) =>
+        readFile(join(f.root, "data/bridge/pending/h123456.json"), "utf8"),
+      ),
+    );
+    expect(mapping.target).toBe("demo-agent");
+  });
+
+  it("rejects missing targets", async () => {
+    const f = await fixture();
+    const response = await kiroRoutes(f.host, {
+      agentsDir: f.agentsDir,
+      dispatch: f.dispatch,
+    }).request("/kiro/handoffs", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ threadId: "t1", target: "missing", message: "validate" }),
+    });
+    expect(response.status).toBe(404);
+    expect(f.dispatch).not.toHaveBeenCalled();
+  });
+
+  it("deduplicates responses and routes needs-input to Action Required", async () => {
+    const f = await fixture();
+    f.threads.set("t1", { threadId: "t1", title: "request" });
+    const app = kiroRoutes(f.host, { agentsDir: f.agentsDir, dispatch: f.dispatch });
+    const body = {
+      handoffId: "h1",
+      threadId: "t1",
+      target: "demo-agent",
+      status: "needs-input",
+      result: "provide path",
+      needsInput: true,
+    };
+    const first = await app.request("/kiro/responses", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+    });
+    const second = await app.request("/kiro/responses", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+    });
+
+    expect(((await first.json()) as { created: boolean }).created).toBe(true);
+    expect(((await second.json()) as { created: boolean }).created).toBe(false);
+    expect(f.messages.get("t1")).toHaveLength(1);
+    expect(f.folders[0]?.name).toBe("Action Required");
+  });
+});
+
+  it("does not recreate metadata when a thread is deleted during response append", async () => {
+    const f = await fixture();
+    f.threads.set("t-race", { threadId: "t-race", title: "request" });
+    vi.mocked(f.host.agent.updateState).mockImplementationOnce(async (threadId: string) => {
+      f.threads.delete(threadId);
+      return { checkpointId: "cp", threadId };
+    });
+    const response = await kiroRoutes(f.host, {
+      agentsDir: f.agentsDir,
+      dispatch: f.dispatch,
+    }).request("/kiro/responses", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        handoffId: "h-race",
+        threadId: "t-race",
+        target: "demo-agent",
+        status: "done",
+        result: "late result",
+      }),
+    });
+
+    expect(response.status).toBe(200);
+    expect(f.threads.has("t-race")).toBe(false);
+  });
+
+it("does not recreate a thread deleted before response delivery", async () => {
+  const f = await fixture();
+  const response = await kiroRoutes(f.host, {
+    agentsDir: f.agentsDir,
+    dispatch: f.dispatch,
+  }).request("/kiro/responses", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({
+      handoffId: "h-orphan",
+      threadId: "deleted-thread",
+      target: "demo-agent",
+      status: "done",
+      result: "late result",
+    }),
+  });
+
+  expect(response.status).toBe(200);
+  expect(await response.json()).toEqual({
+    created: false,
+    threadId: "deleted-thread",
+    handoffId: "h-orphan",
+    orphaned: true,
+  });
+  expect(f.threads.has("deleted-thread")).toBe(false);
+  expect(f.messages.has("deleted-thread")).toBe(false);
+});
