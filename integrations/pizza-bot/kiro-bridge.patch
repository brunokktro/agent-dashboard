new file mode 100644
index 0000000..29f53f5
--- /dev/null
+++ b/apps/web/src/projection/counterpart.ts
@@ -0,0 +1,21 @@
+/** Derives which agent a conversation is with, so replying preselects the right recipient. */
+
+interface MessageLike {
+  parts: ReadonlyArray<{ type: string; text?: string }>;
+}
+
+const HEADER = /^\*\*(?:To|From):\s*([A-Za-z0-9][A-Za-z0-9._-]{0,99})\*\*/;
+
+/**
+ * The bridge stamps every leg with a `**To: x**` / `**From: x**` header, so the newest stamped
+ * message names the counterpart. Plain Pizza Bot chat has no stamps and yields null — replying
+ * there stays a chat, not a handoff.
+ */
+export function threadCounterpart(messages: ReadonlyArray<MessageLike>): string | null {
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const text = messages[i]?.parts.find((part) => part.type === "text")?.text ?? "";
+    const name = HEADER.exec(text)?.[1];
+    if (name) return name;
+  }
+  return null;
+}
