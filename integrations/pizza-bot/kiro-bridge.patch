+import { describe, expect, it } from "vitest";
+import { threadCounterpart } from "./counterpart.js";
+
+const msg = (text: string) => ({ parts: [{ type: "text", text }] });
+
+describe("threadCounterpart", () => {
+  it("names the agent from an outgoing leg", () => {
+    expect(threadCounterpart([msg("**To: demo-agent**\n\noi")])).toBe("demo-agent");
+  });
+
+  it("names the agent from the reply", () => {
+    expect(
+      threadCounterpart([msg("**To: demo-agent**\n\noi"), msg("**From: demo-agent**\n**Status: done**\n\nOK")]),
+    ).toBe("demo-agent");
+  });
+
+  it("takes the newest stamped leg when the counterpart changed mid-thread", () => {
+    expect(
+      threadCounterpart([msg("**To: demo-agent**\n\noi"), msg("**To: second-agent**\n\nagora voce")]),
+    ).toBe("second-agent");
+  });
+
+  it("skips unstamped chat turns to find the stamp underneath", () => {
+    expect(threadCounterpart([msg("**To: demo-agent**\n\noi"), msg("um aparte sem carimbo")])).toBe("demo-agent");
+  });
+
+  it("yields null for plain Pizza Bot chat", () => {
+    expect(threadCounterpart([msg("bom dia"), msg("ola! como posso ajudar?")])).toBeNull();
+  });
+
+  it("does not read a quoted header mid-text as a stamp", () => {
+    expect(threadCounterpart([msg("ele disse **To: fake-agent** no meio da frase")])).toBeNull();
+  });
+
+  it("handles messages without text parts", () => {
+    expect(threadCounterpart([{ parts: [{ type: "file" }] }, msg("**From: demo-agent**\n\nok")])).toBe("demo-agent");
+  });
+
+  it("is empty-safe", () => {
+    expect(threadCounterpart([])).toBeNull();
+  });
+});
